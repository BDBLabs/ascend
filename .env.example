# J-Box environment contract
#
# Copy to .env.local. Never commit a filled-in copy; `npm run secrets:check`
# runs first in `verify:ci` and will fail the build.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Three separate concerns, deliberately not one variable.
#
# The predecessor pointed local, preview, and production at ONE Neon endpoint,
# all authenticating as the table owner. Two consequences followed: local
# development wrote to production, and because the owner holds BYPASSRLS,
# row-level security was inert on every unscoped path. Both are structural, and
# both are avoided by keeping these separate from the first commit.
#
# RULES
#   1. Every environment gets its own Neon branch. Never share an endpoint
#      between local, preview, and production.
#   2. The runtime credential is NEVER the table owner and never holds
#      BYPASSRLS. It connects with almost no privilege of its own and assumes a
#      role per transaction (contractor_app for tenant work, platform_runtime
#      for the cross-tenant paths that legitimately have no tenant).
#   3. The owner credential is used by migrations only, and never ships to a
#      running application.

# Application runtime. Restricted login; must be GRANTed contractor_app and
# platform_runtime so SET LOCAL ROLE succeeds.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Migrations only (`npm run db:migrate`). Table owner. Do not set this in any
# deployed environment.
DATABASE_URL_OWNER=

# Control plane. Separate restricted login that can assume only control_app.
CONTROL_DATABASE_URL=
CONTROL_DATABASE_URL_UNPOOLED=

# Bearer secret for the provisioning API (`Authorization: Bearer <token>`).
# Minimum 16 characters. Shared by the control plane and by the product app's
# self-serve onboarding submit route.
CONTROL_API_TOKEN=

# Base URL of the control plane the product app calls on signup. Defaults to
# the Vercel production URL when unset.
CONTROL_BASE_URL=https://jbox-control.vercel.app

# Model API key for AI-drafted storefront copy (NVIDIA). When unset, onboarding
# falls back to a deterministic template draft. Server-side only.
NVIDIA_API_KEY=

# ---------------------------------------------------------------------------
# Field auth secret rotation
# ---------------------------------------------------------------------------
# Current key version (e.g., v1, v2). Increment on rotation.
FIELD_AUTH_KEY_VERSION=v1
# Current secret (min 32 chars). Used for signing new tokens.
FIELD_AUTH_SECRET=
# Previous keys as JSON array: [{"version":"v1","secret":"...","createdAt":1234567890,"deprecatedAt":1234567890}]
# Used for verifying existing tokens during rotation window.
FIELD_AUTH_PREVIOUS_KEYS_JSON=

# ---------------------------------------------------------------------------
# Field workspace provisioning and demo mode
# ---------------------------------------------------------------------------
# Bearer secret for the staff-provisioning endpoint (`POST /api/auth/register`).
# The endpoint responds 503 when this is not set. Minimum 16 characters.
# Required in any environment where staff accounts are provisioned.
FIELD_PROVISION_SECRET=

# DANGEROUS DEVELOPMENT-ONLY SWITCH. When set to "1" AND
# DEVELOPMENT_FIELD_ORGANIZATION_ID is configured, the Field UI and API resolve
# a synthetic OWNER principal for any request without a valid JWT — including
# in production. Never set "1" on an environment that connects to a database
# holding real tenant data, or that tenant's Field workspace is anonymously
# exposed with owner rights. Leave unset except in an isolated local sandbox.
FIELD_DEMO_MODE=

# The organization id used by the demo/development principal. Only meaningful
# with FIELD_DEMO_MODE=1 and an isolated local sandbox. Never set in a
# deployed environment.
DEVELOPMENT_FIELD_ORGANIZATION_ID=

# ---------------------------------------------------------------------------
# Stripe billing (SaaS subscriptions)
# ---------------------------------------------------------------------------
# Use a Restricted API Key (rk_ prefix) with only the capabilities the server
# needs: customers:write, checkout_sessions:write, subscriptions:read,
# billing_portal.sessions:write.
# NEVER use a live secret key (sk_live_) directly — rotate to a RAK.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The Stripe Price ID for the subscription plan (e.g. price_xxxx).
# Create one Price per plan in your Stripe Dashboard.
STRIPE_PRICE_ID=

# Free trial days before the first charge. Default: 14.
STRIPE_TRIAL_DAYS=14

# Public base URL of the product app, used for Checkout success/cancel URLs.
NEXT_PUBLIC_BASE_URL=https://usejbox.com

# Ascend prototype only: serve the Field login at the deployment root (/).
# Tenant storefront hosts are unaffected (they never reach this branch).
# Leave unset on J-Box deployments to keep the platform shell at /.
# ASCEND_ROOT_IS_FIELD_LOGIN=1

# ---------------------------------------------------------------------------
# Storage, email, and durable delivery
# ---------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN: used by the object/blob storage provider for uploaded
# request photos (see #38 — blob backend). When unset, storage falls back to a
# local directory (STORAGE_DIR below), which is NOT durable on serverless or
# multi-machine runtimes.
BLOB_READ_WRITE_TOKEN=

# STORAGE_DIR: local-filesystem storage root for uploaded photos when no blob
# backend is configured (development fallback, or a single-machine deploy with
# a persistent volume). Absolute path recommended in production.
STORAGE_DIR=

# Resend API key for estimate/notification email delivery. Emails fail closed
# (never queue) when unset. See issue #21 — deliberate production hold.
RESEND_API_KEY=
CRON_SECRET=

# ---------------------------------------------------------------------------
# AI model provider (storefront copy drafting, field assistant)
# ---------------------------------------------------------------------------
# Overrides for the NVIDIA-hosted chat-completions endpoint used by the AI
# drafting/assistant paths. Defaults shown below when unset.
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=meta/llama-3.1-405b-instruct

# ---------------------------------------------------------------------------
# Database pool tuning (optional)
# ---------------------------------------------------------------------------
# All optional; defaults shown are used when unset.
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=10000
CONTROL_DATABASE_POOL_MAX=5

# JavaScript / SQL tooling verbosity (optional debug).
VERBOSE=

# ---------------------------------------------------------------------------
# Distributed rate limiting (Upstash Redis)
# ---------------------------------------------------------------------------
# When configured, rate limits are shared across all instances.
# Create a database at https://upstash.com and add the REST URL and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Hashed customer document links. Preserve superseded keys only for their
# bounded rotation window, then remove them.
CUSTOMER_LINK_KEY_VERSION=v1
CUSTOMER_LINK_SECRET=
CUSTOMER_LINK_PREVIOUS_KEYS_JSON=
